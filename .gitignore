# Media, models, engines: never commit
*.mp4
*.mkv
*.avi
*.mov
*.h264
*.h265
*.engine
*.plan
*.onnx
*.etlt
*.pt
*.pth
*.trt
*.npy
*.zip

# Raw inputs (large / private); keep locally only
inputs/*
!inputs/layout_v2.png

# Third-party checkouts and generated outputs
external/
experiments/*/
!experiments/.gitkeep

# Python
__pycache__/
*.pyc
*.egg-info/
.pytest_cache/
.venv/
build/
dist/

# Build outputs (apps/courttrack, apps/jersey; the court app itself is built under external/)
*.o
*.a
*.so
apps/courttrack/ct_replay

# Run logs and loose files at the top of experiments/ (run outputs live in experiments/<run>/)
experiments/*
!experiments/.gitkeep

# Images of people: ground-truth crops stay local (published video frames are sanitized first)
gt/*/sprites/

# Downloaded models (RTMPose etc.)
models/
